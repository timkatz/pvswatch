# SunPower Web Monitor Configuration
# Copy this file to .env and fill in your values

# ── PVS Gateway ───────────────────────────────────────────────────────
# Your PVS local IP address (find it in your router's DHCP client list,
# or — if connecting via the PVS6 installer-port WiFi — typically 172.27.153.1)
PVS_IP=

# PVS auth username (always ssm_owner for SunPower gateways)
PVS_USER=ssm_owner

# PVS auth password — the LAST 5 CHARACTERS of your PVS *internal* serial number.
# NOT the serial printed on the label. To find your internal serial, visit:
#   http://<PVS_IP>/vars?name=/sys/info/serialnum
# Then take the last 5 characters of the value returned.
PVS_PASS=

# Full internal serial number (for reference)
PVS_SERIAL=

# ── Dashboard ─────────────────────────────────────────────────────────
# Host port where the dashboard will be accessible
DASHBOARD_PORT=5001

# PVS request timeout in seconds (the dl_cgi endpoint can be very slow)
TIMEOUT_SECS=120

# Background refresh interval in seconds (5 min default — /sys/livedata updates every few seconds; PVS scan cycle is ~40-60 min for meter values)
REFRESH_SECS=300

# Data storage directory (used by docker-compose for volume mapping)
DATA_DIR=./data

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Savings model (used by /history period_totals — Savings card on dashboard)
# COST_PER_KWH: utility rate ($/kWh) — 0.30 California avg, 0.13 US avg
# CO2_LBS_PER_KWH: grid emissions factor — 0.85 US avg, 0.5 California, 1.5 coal-heavy
COST_PER_KWH=0.30
CO2_LBS_PER_KWH=0.85
# Optional time-of-use plan (all-in $/kWh, delivery + generation). When set,
# "Cost saved" is the bill difference sum((home - grid import) x rate at that
# time), so exports (NEM netting) and battery time-shifting count. Single line,
# single-quoted. First matching period wins; one without "hours" is the default.
# TOU_RATES='{"tz":"America/Los_Angeles","adder":0.05,"seasons":[{"months":[6,7,8,9],"periods":[{"name":"On peak","rate":0.62,"hours":[16,21],"days":"weekday"},{"name":"Off peak","rate":0.28}]},{"months":[10,11,12,1,2,3,4,5],"periods":[{"name":"Mid peak","rate":0.52,"hours":[16,21]},{"name":"Off peak","rate":0.29}]}]}'

# Net Cost card: fixed monthly solar payment (lease / PPA / loan), and the
# first month (YYYY-MM) it applies to (blank = every bill).
# SOLAR_MONTHLY_COST=0
# SOLAR_COST_START=
# Optional: sync utility bills + 15-min meter data from utilityapi.com.
# UTILITY_API_TOKEN=
# UTILITY_API_SYNC_HOURS=24
# Day of month to request one fresh collection (UtilityAPI's first per
# month is free; later ones are billed). 0 = off.
# UTILITY_API_REFRESH_DAY=24

# Stale-data alerts (optional): push to an ntfy topic when the PVS stops
# responding for ALERT_STALE_MINS, and again when it recovers.
# Pick a long random topic name — anyone who knows it can read it.
# NTFY_URL=https://ntfy.sh/your-random-topic-name
# NTFY_TOKEN=
# NTFY_EMAIL=you@example.com   # ntfy also forwards each alert by email
#                               (ntfy.sh requires an account + NTFY_TOKEN for email)
# ALERT_STALE_MINS=30
# Also alert when usable battery charge drops below this % (0 = off):
# ALERT_BATTERY_PCT=20
# SunVault grid/backup state check interval; alerts on every change (0 = off):
# MIDSTATE_POLL_SECS=60
# Optional second server, tried only if the first fails (e.g. self-hosted
# primary above, ntfy.sh as backup):
# NTFY_FALLBACK_URL=https://ntfy.sh/your-random-topic-name
# NTFY_FALLBACK_TOKEN=

# Outage tracking (dashboard "Outages" card + shaded chart bands)
# PVS offline = gap in history longer than OUTAGE_GAP_MINS.
# OUTAGE_GAP_MINS=20
# Grid power outages from an apcupsd UPS on this host: directory that
# contains apcupsd.events (mounted read-only). Leave unset to disable.
# UPS_LOG_DIR=/var/log
